{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://piecs.dev/schemas/package-1.0.0.json",
  "title": "PIECS Package",
  "description": "Portable, provider-neutral package exchanged between PIECS-compatible tools.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "schemaVersion",
    "packageId",
    "exportedAt",
    "source",
    "content"
  ],
  "properties": {
    "kind": {
      "const": "piecs.package"
    },
    "schemaVersion": {
      "const": "1.0.0"
    },
    "packageId": {
      "type": "string",
      "format": "uuid"
    },
    "exportedAt": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        }
      }
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "templates",
        "workflows"
      ],
      "properties": {
        "templates": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "maxItems": 1000
        },
        "workflows": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "maxItems": 500
        }
      }
    }
  }
}
