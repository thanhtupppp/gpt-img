{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://piecs.dev/schemas/package-1.0.0.json",
  "title": "PIECS Package",
  "description": "Portable, provider-neutral package exchanged between PIECS-compatible tools.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "schemaVersion",
    "packageId",
    "exportedAt",
    "source",
    "content"
  ],
  "properties": {
    "kind": {
      "const": "piecs.package"
    },
    "schemaVersion": {
      "const": "1.0.0"
    },
    "packageId": {
      "type": "string",
      "format": "uuid"
    },
    "exportedAt": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "templates",
        "workflows"
      ],
      "properties": {
        "templates": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "$ref": "#/$defs/template"
          }
        },
        "workflows": {
          "type": "array",
          "maxItems": 500,
          "items": {
            "$ref": "#/$defs/workflow"
          }
        }
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        }
      }
    },
    "scalarMap": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "boolean"
        ]
      }
    },
    "template": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "description",
        "category",
        "profile",
        "commandIds",
        "parameters",
        "tags",
        "origin",
        "version",
        "schemaVersion",
        "createdAt",
        "updatedAt"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "description": {
          "type": "string",
          "maxLength": 2000
        },
        "category": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "profile": {
          "enum": [
            "Professional",
            "Studio",
            "Master"
          ]
        },
        "commandIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "maxItems": 100
        },
        "parameters": {
          "$ref": "#/$defs/scalarMap"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 80
          },
          "maxItems": 100
        },
        "origin": {
          "const": "custom"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "schemaVersion": {
          "const": "1.0.0"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "workflowStep": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "commandId",
        "parameters"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "commandId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "parameters": {
          "$ref": "#/$defs/scalarMap"
        }
      }
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "description",
        "steps",
        "version",
        "schemaVersion",
        "createdAt",
        "updatedAt"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/workflowStep"
          }
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "schemaVersion": {
          "const": "1.0.0"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
